{
  "DbConnectionStrings": {
    "ChatServerDbConnectionString": ""
  },
  "Valkey": {
    "Host": "localhost",
    "Port": 6379
  },
  "ConnectionCache": {
    "Host": "localhost",
    "Port": 6379
  },
  "RabbitMq": {
    "Host": "",
    "Username": "",
    "Password": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "TokenLifeTimeInMinutes": 40
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "labels": [
            {
              "key": "app",
              "value": "cypherly.chatserver.svc"
            }
          ],
          "textFormatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "useInternalTimestamp":  true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProperty(\"app\", \"cypherly.chatserver.svc\")",
      "WithProperty(\"level\", \"${Level}\")",
      "WithProperty(\"env\", \"prod\")"
    ],
    "Properties": {
      "Application": "cypherly.keystore.svc"
    }
  },
  "AllowedOrigins": [
    "http://localhost:8080",
    "http://localhost:8081",
    "http://localhost:8082",
    "http://localhost:8083",
    "http://localhost:8084"
  ]
}
